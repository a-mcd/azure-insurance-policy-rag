# .env gets populated with the following properties by the script
# scripts/setup_env/setup_azure_openai.sh.
# You can also manually set these values in this file.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
# Optional read-only key. Searching and answering use it in preference to the
# admin key, which is only needed to create the index and upload chunks.
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_INDEX_NAME=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Optional chat model settings. Uncomment to change them.
# Reasoning effort sent to the chat model (default: minimal, suited to GPT-5).
# Leave the value empty for models without reasoning, such as GPT-4o, which
# reject this parameter.
# AZURE_OPENAI_REASONING_EFFORT=minimal
# Maximum tokens the model may generate, including hidden reasoning tokens
# (default: 2000).
# AZURE_OPENAI_MAX_COMPLETION_TOKENS=2000
